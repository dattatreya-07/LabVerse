# LabVerse Public Deployment & Environment Configuration Template
# All secret values must be set in your secure deployment environment or .env.local (ignored by git)

# ====================================================================
# 1. AI TUTOR ENGINE (Groq LLM)
# ====================================================================
# GROQ_API_KEY: Server-side API key for live Groq LLM inference (llama-3.3-70b-versatile)
# Leave empty to use the built-in offline curated RAG knowledge engine.
GROQ_API_KEY=

# GROQ_MODEL: Configurable Groq model ID (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# ====================================================================
# 2. DATABASE & AUTHENTICATION (Supabase Postgres - Optional)
# ====================================================================
# Leave empty to operate 100% in Guest Mode (localStorage persistence).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ====================================================================
# 3. SECURITY & RATE LIMITING
# ====================================================================
# Maximum request body size limit in bytes (default: 102400 = 100 KB)
MAX_PAYLOAD_BYTES=102400
