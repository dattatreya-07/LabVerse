# LabVerse Environment Configuration
# GROQ_API_KEY: Server-side API key for live Groq LLM inference (llama-3.3-70b-versatile)
# Leave empty to use the built-in curated grounded RAG knowledge engine.
GROQ_API_KEY=

# GROQ_MODEL: Configurable Groq model ID (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile
